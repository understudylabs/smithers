{
  "name": "wire-compat-ts",
  "version": "0.0.0",
  "description": "TS twin of the wire-compat workflow, run via Smithers CLI to produce a row dump diffable against the Python port.",
  "type": "module",
  "private": true,
  "scripts": {
    "run": "smithers up workflow.tsx --run-id wire-compat-ts --input '{\"workload\":\"snapshot\",\"branch\":true,\"iterations\":3}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smithers-orchestrator": "^0.20.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "~5.9.3"
  }
}
